PORT=5000
# Set your OpenAI-compatible API key (Groq, Gemini, OpenAI, etc.)
# If left blank, the server automatically uses the built-in Raghu simulation engine.
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
CLIENT_ORIGIN=http://localhost:5173

# [VOICE-UPGRADE START]
# Text-to-Speech Provider ("google" | "elevenlabs" | "none")
# TTS_PROVIDER=none
# TTS_API_KEY=your_tts_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# [VOICE-UPGRADE END]
# [SUGGESTIONS START]
# Enable suggested next player replies (default true)
# SUGGESTIONS_ENABLED=true
# [SUGGESTIONS END]
